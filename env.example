# Valores LOCAIS de exemplo. Não há segredos reais aqui.
# Para usar no shell:  set -a; . ./.env; set +a

# --- HTTP ---
HTTP_ADDR=:8080

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=wager
DB_PASSWORD=wager
DB_NAME=wager

# --- SQS (LocalStack) ---
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENT_QUEUE_NAME=wager-events.fifo

# --- Autenticação (Keycloak) ---
# "iss" esperado nos tokens (URL vista pelo cliente).
AUTH_ISSUER_URL=http://localhost:8081/realms/wager
# URL para descoberta/JWKS quando difere do issuer (ex.: dentro do Docker).
AUTH_DISCOVERY_URL=
AUTH_AUDIENCE=wager-api

# --- Regras de negócio ---
# Quanto tempo uma reversão espera pela referência antes de ser rejeitada.
PENDING_REFERENCE_TTL=5m

# --- Observabilidade ---
LOG_LEVEL=info

# --- Testes de integração (opcionais; estes são os padrões) ---
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=wager
TEST_DB_PASSWORD=wager
TEST_DB_ADMIN_DB=wager
KEYCLOAK_URL=http://localhost:8081
